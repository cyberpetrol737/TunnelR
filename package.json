    "check": "node scripts/check.js",
    "demo": "node scripts/demo.js",
    "typecheck": "tsc -p jsconfig.json"
  },
  "files": [
    "bin",
    "src",
    "dashboard",
    "docs",
    "deploy",
    ".env.example"
  ]
}
