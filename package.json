{
  "name": "tunnelr",
  "version": "1.0.0",
  "description": "Expose a local web server through a self-hosted, authenticated and encrypted relay.",
  "private": true,
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "src/index.js",
  "bin": {
    "tunnelr": "bin/tunnelr.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node bin/tunnelr.js start",
    "relay": "node bin/tunnelr.js relay",
